# openclaw smoke test — example configuration
# ---------------------------------------------
# Copy to config.env (which is gitignored) and fill in:
#     cp config.example.env config.env
# Or export any of these as environment variables before running smoke-test.sh.
# Every value is optional; unset checks are reported as SKIP, not FAIL.

# --- General ---------------------------------------------------------------
# Per-request HTTP timeout in seconds.
HTTP_TIMEOUT=10

# --- openclaw agent --------------------------------------------------------
# Command/binary that launches the agent (must be in PATH).
OPENCLAW_BIN=openclaw
# Args used to print the version line.
OPENCLAW_VERSION_ARGS=--version
# pgrep pattern used to confirm the agent process is running.
OPENCLAW_PROCESS_PATTERN=openclaw
# Optional local health endpoint the agent exposes; a 2xx == healthy.
OPENCLAW_HEALTH_URL=http://127.0.0.1:8080/health

# --- Device(s): Oppo + "other system" --------------------------------------
# Comma-separated, case-insensitive substrings expected in the device identity
# (manufacturer + model + Android version). Leave blank to just report it.
EXPECTED_DEVICES=oppo

# --- AI model (OpenAI-compatible) ------------------------------------------
# Base URL up to and including /v1 (no trailing slash needed).
MODEL_API_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-...
MODEL_NAME=gpt-4o-mini
# "models" = cheap GET /models reachability check (default).
# "chat"   = POST a 1-token /chat/completions request (costs a token).
MODEL_PING_MODE=models

# --- Integration endpoints ("other system") --------------------------------
# Comma- or newline-separated list. Each entry is NAME=URL or just URL.
# A 2xx or 3xx response counts as a pass.
INTEGRATION_ENDPOINTS=api=https://example.com/api/health,db-proxy=https://example.com/db/ping

# --- Telegram (report channel + checked itself) ----------------------------
# Create a bot with @BotFather to get the token; message the bot then read
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
# auto   = deliver report only when something FAILED (default; less noise)
# always = deliver every run
# never  = never deliver (token is still validated as a check)
TELEGRAM_NOTIFY=auto
